# zest-data-api configuration. All vars are prefixed ZEST_API_ (see src/zest_data_api/config.py).
# Copy to .env for local development.

# --- Database ---------------------------------------------------------------
# SQLAlchemy URL for the target PostgreSQL. Uses the psycopg v3 driver.
#   local docker-compose (this repo's db, host port 5433):
#       postgresql+psycopg://zest:zest@localhost:5433/zest
#   port-forward to the cluster DB (kubectl port-forward svc/postgres-db 5432:5432):
#       postgresql+psycopg://zest:zest@localhost:5432/zest
#   in-cluster (zest-cloud-k8s postgres):
#       postgresql+psycopg://zest:zest@postgres-db:5432/zest
ZEST_API_DATABASE_URL=postgresql+psycopg://zest:zest@localhost:5433/zest

# Echo SQL to logs (noisy; dev only).
ZEST_API_DB_ECHO=false

# --- HTTP / CORS ------------------------------------------------------------
# JSON array or comma-separated list of allowed browser origins for the dashboard.
# The dashboard normally reaches this API same-origin via an nginx/Vite proxy, so
# CORS is only needed when the browser calls the API cross-origin directly.
ZEST_API_CORS_ORIGINS=["http://localhost:5173"]

# Root path when served behind a stripping reverse proxy (e.g. "/api/datasets").
# Leave empty when served at the domain root.
ZEST_API_ROOT_PATH=

# --- Uploads ----------------------------------------------------------------
# Max upload size (bytes) accepted per file by POST /datasets. Default 64 MiB.
ZEST_API_MAX_UPLOAD_BYTES=67108864

# --- Object storage (MinIO / S3-compatible) ---------------------------------
# Where dataset files are stored. Leave ZEST_API_STORAGE_ENDPOINT empty to use an
# in-memory store (tests / quick runs with no MinIO).
#   local docker-compose minio:   localhost:9000
#   in-cluster (zest-cloud-k8s):  minio:9000
ZEST_API_STORAGE_ENDPOINT=localhost:9000
ZEST_API_STORAGE_ACCESS_KEY=zest
ZEST_API_STORAGE_SECRET_KEY=zest-minio-dev
ZEST_API_STORAGE_BUCKET=datasets
# true only when MinIO is behind TLS.
ZEST_API_STORAGE_SECURE=false
